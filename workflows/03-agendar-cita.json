    {
      "parameters": {
        "jsCode": "const r=$items('Entrada agendar cita')[0].json; const barberos=$items('Leer barberos para validar').map(i=>i.json),servicios=$items('Leer servicios para validar').map(i=>i.json),citas=$items('Leer citas para validar').map(i=>i.json); const servicio=servicios.find(i=>i.servicio_id===r.servicio_id); if(!servicio)throw new Error('El servicio solicitado no existe.'); const barbero=barberos.find(i=>i.barbero_id===r.barbero_id&&i.activo===true&&String(i.servicios||'').split('|').includes(r.servicio_id)); if(!barbero)throw new Error('El barbero no está activo o no realiza ese servicio.'); const fecha=String(r.fecha||'').slice(0,10),hora=String(r.hora_inicio||''); if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)||!/^([01]\\d|2[0-3]):(00|30)$/.test(hora))throw new Error('Fecha u hora inválidas.'); const d=new Date(fecha+'T00:00:00'),hoy=new Date();hoy.setHours(0,0,0,0);const limite=new Date(hoy);limite.setDate(limite.getDate()+30);if(d<hoy||d>limite||d.getDay()===0)throw new Error('La fecha no está dentro del periodo permitido.'); const toMin=t=>{const [h,m]=t.split(':').map(Number);return h*60+m},inicio=toMin(hora),fin=inicio+Number(servicio.duracion_minutos);if(inicio<600||fin>1200)throw new Error('El servicio no cabe en el horario laboral.'); const ocupada=citas.some(i=>i.estado==='confirmada'&&String(i.fecha).slice(0,10)===fecha&&i.barbero_id===r.barbero_id&&inicio<toMin(i.hora_fin)&&fin>toMin(i.hora_inicio));if(ocupada)throw new Error('Ese horario ya no está disponible.'); return [{json:{...r,fecha,cita_id:'cita_'+Date.now(),hora_fin:String(Math.floor(fin/60)).padStart(2,'0')+':'+String(fin%60).padStart(2,'0'),estado:'confirmada'}}];"
      },
