    {
      "parameters": {
        "jsCode": "const citaId=$items('Entrada cancelar cita')[0].json.cita_id; const cita=$input.all().map(i=>i.json).find(i=>i.cita_id===citaId); if(!cita)throw new Error('La cita no existe.'); if(cita.estado!=='confirmada')throw new Error('La cita ya no está confirmada y no se puede cancelar.'); const fecha=String(cita.fecha).slice(0,10); if(new Date(fecha+'T23:59:59')<new Date())throw new Error('Solo se pueden cancelar citas futuras.'); return {json:{cita_id:citaId,estado:'cancelada'}};"
      },
